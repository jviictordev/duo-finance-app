# Front do Junto — SPA estática + reverse proxy da API (mesma origem, sem CORS).
#
#   CADDY_SITE    domínio público, ex.: app.duofinance.app  (":80" roda sem TLS)
#   API_UPSTREAM  host:porta da API, ex.: api:3333  (serviço na rede docker `duo`)
#
# `handle` blocks são exclusivos e avaliados em ordem — o primeiro que casa vence,
# então o try_files da SPA nunca reescreve uma chamada de API.

{$CADDY_SITE:localhost} {
	encode gzip

	# SSE — resposta sem buffer
	handle /stream* {
		reverse_proxy {$API_UPSTREAM:api:3333} {
			flush_interval -1
		}
	}

	# API (mesma origem que o front)
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3333}
	}
	handle /health {
		reverse_proxy {$API_UPSTREAM:api:3333}
	}

	# SPA — tudo o mais serve os estáticos, com fallback para index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		@immutable path *.js *.css *.woff2 *.woff *.png *.svg *.webp *.ico
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}
}

# Domínio público do app (Caddy emite TLS via Let's Encrypt automaticamente).
# Use ":80" para rodar sem TLS (atrás de outro proxy / em teste).
CADDY_SITE=app.duofinance.app

# Onde a API responde, visível de dentro do container do front.
# Topologia A (recomendada): nome do serviço da API na rede docker `duo`.
API_UPSTREAM=api:3333
